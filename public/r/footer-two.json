      "content": "import React from \"react\";\nimport { ArrowRight } from \"lucide-react\";\nimport Link from \"next/link\";\nimport { Button } from \"@/registry/default/ui/button\";\nimport Image from \"next/image\";\n\nconst Footer: React.FC = () => {\n    return (\n        <>\n            <footer className=\"mt-20 w-full px-8 pt-8\">\n                <div className=\"\">\n                    <div className=\"grid grid-cols-1 gap-x-8 gap-y-16 lg:grid-cols-2\">\n                        <nav>\n                            <ul role=\"list\" className=\"grid grid-cols-2 gap-8 sm:grid-cols-3\">\n                                <li>\n                                    <div className=\"font-display text-sm font-semibold tracking-wider\">\n                                        Pages\n                                    </div>\n                                    <ul className=\"mt-4 text-sm text-muted-foreground\">\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"#\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                Home\n                                            </Link>\n                                        </li>\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"#\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                All Products\n                                            </Link>\n                                        </li>\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"#\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                Categories\n                                            </Link>\n                                        </li>\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"/profile\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                Profile\n                                            </Link>\n                                        </li>\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"/contact\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                Contact Us\n                                            </Link>\n                                        </li>\n                                    </ul>\n                                </li>\n                                <li>\n                                    <div className=\"font-display text-sm font-semibold tracking-wider\">\n                                        Socials\n                                    </div>\n                                    <ul className=\"mt-4 text-sm text-muted-foreground\">\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"#\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                Facebook\n                                            </Link>\n                                        </li>\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"#\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                Instagram\n                                            </Link>\n                                        </li>\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"#\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                Twitter\n                                            </Link>\n                                        </li>\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"#\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                LinkedIn\n                                            </Link>\n                                        </li>\n                                    </ul>\n                                </li>\n                                <li>\n                                    <div className=\"font-display text-sm font-semibold tracking-wider\">\n                                        Legal\n                                    </div>\n                                    <ul className=\"mt-4 text-sm text-muted-foreground\">\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"#\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                Privacy Policy\n                                            </Link>\n                                        </li>\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"#\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                Terms of Service\n                                            </Link>\n                                        </li>\n                                        <li className=\"mt-4\">\n                                            <Link\n                                                href=\"#\"\n                                                className=\"transition hover:text-neutral-950 dark:hover:text-white\"\n                                            >\n                                                Cookie Policy\n                                            </Link>\n                                        </li>\n                                    </ul>\n                                </li>\n                            </ul>\n                        </nav>\n                        <div className=\"flex lg:justify-end\">\n                            <form className=\"max-w-sm\">\n                                <h2 className=\"font-display text-sm font-semibold tracking-wider\">\n                                    Sign up for our newsletter\n                                </h2>\n                                <p className=\"mt-4 text-sm text-muted-foreground\">\n                                    Subscribe to get the latest design news, articles, resources\n                                    and inspiration.\n                                </p>\n                                <div className=\"relative mt-6\">\n                                    <input\n                                        placeholder=\"Email address\"\n                                        autoComplete=\"email\"\n                                        aria-label=\"Email address\"\n                                        className=\"block w-full rounded-2xl border bg-transparent py-4 pl-6 pr-20 text-base/6 transition\"\n                                        type=\"email\"\n                                    />\n                                    <div className=\"absolute inset-y-1 right-1 flex justify-end\">\n                                        <Button\n                                            type=\"submit\"\n                                            aria-label=\"Submit\"\n                                            className=\"flex aspect-square h-full items-center justify-center rounded-xl bg-neutral-950 text-white transition hover:bg-neutral-800 dark:bg-white dark:hover:bg-white/90 dark:text-neutral-950\"\n                                        >\n                                            <ArrowRight size={16} />\n                                        </Button>\n                                    </div>\n                                </div>\n                            </form>\n                        </div>\n                    </div>\n                    <div className=\"mb-20 mt-24 flex flex-wrap items-end justify-between gap-x-6 gap-y-4 border-t pt-12\">\n                        <Link\n                            href={\"/\"}\n                            className=\"flex justify-start items-center\"\n                        >\n                            <div className=\"logo flex items-center justify-start gap-1\">\n                                <Image\n                                    alt=\"logo\"\n                                    loading=\"lazy\"\n                                    width={30}\n                                    height={30}\n                                    decoding=\"async\"\n                                    data-nimg=\"1\"\n                                    src={'/logo/logo-dark-theme.svg'}\n                                    className=\"rounded hidden dark:block size-[2rem]\"\n                                />\n                                <Image\n                                    alt=\"logo\"\n                                    loading=\"lazy\"\n                                    width={30}\n                                    height={30}\n                                    decoding=\"async\"\n                                    data-nimg=\"1\"\n                                    src={'/logo/logo-light-theme.svg'}\n                                    className=\"rounded dark:hidden size-[2rem]\"\n                                />\n                                <h1 className=\"text-xl font-semibold\">Voxlet UI</h1>\n                            </div>\n                        </Link>\n                        <p className=\"text-sm text-muted-foreground\">© Voxlet UI. 2025</p>\n                    </div>\n                </div>\n            </footer>\n            <div className=\"sm:hidden w-fullh h-[5rem]\"></div>\n        </>\n    );\n};\n\nexport default Footer;",
