{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sign-up-dialog",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "https://ui.voxletstudio.com/r/button.json",
    "https://ui.voxletstudio.com/r/dialog.json",
    "https://ui.voxletstudio.com/r/input.json",
    "https://ui.voxletstudio.com/r/label.json"
  ],
  "files": [
    {
      "path": "registry/default/blocks/authentication/sign-up-dialog.tsx",
      "content": "import { Button } from \"@/registry/default/ui/button\";\nimport {\n    Dialog,\n    DialogContent,\n    DialogDescription,\n    DialogHeader,\n    DialogTitle,\n    DialogTrigger,\n} from \"@/registry/default/ui/dialog\";\nimport { Input } from \"@/registry/default/ui/input\";\nimport { Label } from \"@/registry/default/ui/label\";\nimport { LogIn } from \"lucide-react\";\nimport { useId } from \"react\";\n\nexport default function SignUpDialog() {\n    const id = useId();\n    return (\n        <div className=\"min-h-[20rem] w-full flex items-center justify-center\">\n            <Dialog>\n                <DialogTrigger asChild>\n                    <Button variant=\"outline\">Sign up</Button>\n                </DialogTrigger>\n                <DialogContent className=\"max-w-md z-[200]\">\n                    <div className=\"flex flex-col items-center gap-2\">\n                        <div\n                            className=\"flex size-11 shrink-0 items-center justify-center rounded-full border\"\n                            aria-hidden=\"true\"\n                        >\n                           <LogIn className=\"size-4\"/>\n                        </div>\n                        <DialogHeader>\n                            <DialogTitle className=\"sm:text-center\">Sign up Voxlet UI</DialogTitle>\n                            <DialogDescription className=\"sm:text-center\">\n                                We just need a few details to get you started.\n                            </DialogDescription>\n                        </DialogHeader>\n                    </div>\n\n                    <form className=\"space-y-5\">\n                        <div className=\"space-y-4\">\n                            <div className=\"*:not-first:mt-2\">\n                                <Label htmlFor={`${id}-name`}>Full name</Label>\n                                <Input id={`${id}-name`} placeholder=\"Kaif\" type=\"text\" required />\n                            </div>\n                            <div className=\"*:not-first:mt-2\">\n                                <Label htmlFor={`${id}-email`}>Email</Label>\n                                <Input id={`${id}-email`} placeholder=\"mail@yourcompany.com\" type=\"email\" required />\n                            </div>\n                            <div className=\"*:not-first:mt-2\">\n                                <Label htmlFor={`${id}-password`}>Password</Label>\n                                <Input\n                                    id={`${id}-password`}\n                                    placeholder=\"Enter your password\"\n                                    type=\"password\"\n                                    required\n                                />\n                            </div>\n                        </div>\n                        <Button type=\"button\" className=\"w-full\">\n                            Sign up\n                        </Button>\n                    </form>\n\n                    <div className=\"before:bg-border after:bg-border flex items-center gap-3 before:h-px before:flex-1 after:h-px after:flex-1\">\n                        <span className=\"text-muted-foreground text-xs\">Or</span>\n                    </div>\n\n                    <Button variant=\"outline\">Continue with Google</Button>\n\n                    <p className=\"text-muted-foreground text-center text-xs\">\n                        By signing up you agree to our{\" \"}\n                        <a className=\"underline hover:no-underline\" href=\"#\">\n                            Terms\n                        </a>\n                        .\n                    </p>\n                </DialogContent>\n            </Dialog>\n        </div>\n    );\n}\n",
      "type": "registry:block"
    }
  ],
  "type": "registry:block"
}